<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="painelPrincipal" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agendajava.controller.DashboardController">
   <left>
      <VBox prefWidth="220.0" spacing="10.0" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
         <children>
            <Label text="MENU PRINCIPAL" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #95a5a6; -fx-padding: 0 0 15 0;" />
            <Button onAction="#abrirTelaAgendamentos" text="Meus Agendamentos" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: BASELINE_LEFT; -fx-font-size: 14px; -fx-cursor: hand; -fx-border-color: transparent transparent #34495e transparent; -fx-border-width: 0 0 1 0; -fx-padding: 10 0 10 0;"/>
            <Button onAction="#abrirTelaMarcarConsulta" text="Marcar Consulta" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: BASELINE_LEFT; -fx-font-size: 14px; -fx-cursor: hand; -fx-border-color: transparent transparent #34495e transparent; -fx-border-width: 0 0 1 0; -fx-padding: 10 0 10 0;"/>
            
            <Button fx:id="btnMarcarExame" onAction="#abrirTelaMarcarExame" text="Marcar Exame" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: BASELINE_LEFT; -fx-font-size: 14px; -fx-cursor: hand; -fx-border-color: transparent transparent #34495e transparent; -fx-border-width: 0 0 1 0; -fx-padding: 10 0 10 0;"/>
            <Button fx:id="btnMarcarCirurgia" onAction="#abrirTelaMarcarCirurgia" text="Marcar Cirurgia" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: BASELINE_LEFT; -fx-font-size: 14px; -fx-cursor: hand; -fx-border-color: transparent transparent #34495e transparent; -fx-border-width: 0 0 1 0; -fx-padding: 10 0 10 0;"/>
            
            <VBox VBox.vgrow="ALWAYS" />
            
            <Button fx:id="btnRodarAlgoritmo" onAction="#processarFilaCirurgias" text="Rodar Algoritmo de Cirurgias" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #f39c12; -fx-alignment: BASELINE_LEFT; -fx-font-size: 14px; -fx-cursor: hand; -fx-border-color: transparent transparent #34495e transparent; -fx-border-width: 0 0 1 0; -fx-padding: 10 0 10 0; -fx-font-weight: bold;"/>
            <Button onAction="#fazerLogout" text="Sair (Logout)" maxWidth="Infinity" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10; -fx-cursor: hand; -fx-margin: 10 0 0 0;"/>
         </children>
      </VBox>
   </left>
   <center>
      <VBox alignment="CENTER" spacing="10">
         <Label fx:id="labelBemVindo" text="Bem-vindo!" style="-fx-font-size: 26px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
      </VBox>
   </center>
</BorderPane>