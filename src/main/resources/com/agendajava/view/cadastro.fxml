<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0" prefWidth="400.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agendajava.controller.CadastroController">
   <children>
      <VBox alignment="CENTER" spacing="15.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="40.0" AnchorPane.bottomAnchor="40.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 30;">
         <children>
            <Label text="Novo Paciente" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
            
            <VBox spacing="5.0" prefWidth="250.0">
               <Label text="Nome Completo" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
               <TextField fx:id="nomeInput" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 8;"/>
            </VBox>
            
            <VBox spacing="5.0" prefWidth="250.0">
               <Label text="E-mail" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
               <TextField fx:id="emailInput" promptText="seu@email.com" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 8;"/>
            </VBox>
            
            <VBox spacing="5.0" prefWidth="250.0">
               <Label text="Senha" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
               <PasswordField fx:id="senhaInput" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 8;"/>
            </VBox>
            
            <Button onAction="#cadastrarPaciente" prefWidth="250.0" text="Criar Conta" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10; -fx-cursor: hand; -fx-margin: 10 0 0 0;"/>
            <Button onAction="#voltarParaLogin" prefWidth="250.0" text="Voltar ao Login" style="-fx-background-color: transparent; -fx-text-fill: #95a5a6; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-color: transparent;"/>
            
            <Label fx:id="mensagemFeedback" textFill="#e74c3c" wrapText="true" textAlignment="CENTER" style="-fx-font-weight: bold;"/>
         </children>
      </VBox>
   </children>
</AnchorPane>