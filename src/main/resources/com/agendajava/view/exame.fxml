<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agendajava.controller.ExameController">
   <children>
      <VBox alignment="CENTER_LEFT" layoutX="50.0" layoutY="30.0" spacing="15.0">
         <children>
            <Label text="Agendar Novo Exame">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Label text="Nome do Exame (ex: Raio-X Torax):" />
            <TextField fx:id="nomeInput" prefWidth="300.0" />
            
            <Label text="Data:" />
            <DatePicker fx:id="dataInput" prefWidth="300.0" />
            
            <Label text="Horário (HH:mm):" />
            <TextField fx:id="horaInput" prefWidth="300.0" promptText="Ex: 10:00" />
            
            <Label text="Duração Estimada (em minutos):" />
            <TextField fx:id="duracaoInput" prefWidth="300.0" promptText="Ex: 45" />
            
            <Label text="Nome da Sala:" />
            <TextField fx:id="salaInput" prefWidth="300.0" promptText="Sala 1" />
            
            <Button mnemonicParsing="false" onAction="#agendarExame" text="Confirmar Agendamento" />
            <Label fx:id="mensagemFeedback" textFill="RED" />
         </children>
      </VBox>
   </children>
</AnchorPane>